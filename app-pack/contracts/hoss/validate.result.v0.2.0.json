{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://demon.io/contracts/hoss/validate.result.v0.2.0.json",
  "title": "HOSS Validate Result v0.2.0",
  "description": "Result envelope for HOSS fabric topology validation with aggregated multi-target support",
  "type": "object",
  "required": ["status", "counts", "tool", "metrics"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["ok", "warning", "error"],
      "description": "Overall validation status (ok only if all targets pass)"
    },
    "metrics": {
      "type": "object",
      "description": "Execution metrics and mirrored counts",
      "required": ["durationMs", "exitCode", "counts"],
      "properties": {
        "durationMs": {
          "type": "integer",
          "minimum": 0,
          "description": "Total execution duration in milliseconds"
        },
        "exitCode": {
          "type": "integer",
          "minimum": 0,
          "description": "Process exit code from validation runtime"
        },
        "counts": {
          "type": "object",
          "required": ["validated", "warnings", "failures"],
          "properties": {
            "validated": { "type": "integer", "minimum": 0 },
            "warnings":  { "type": "integer", "minimum": 0 },
            "failures":  { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "counts": {
      "type": "object",
      "required": ["validated", "warnings", "failures"],
      "properties": {
        "validated": {
          "type": "integer",
          "minimum": 0,
          "description": "Total number of topologies validated across all targets"
        },
        "warnings": {
          "type": "integer",
          "minimum": 0,
          "description": "Total number of validation warnings across all targets"
        },
        "failures": {
          "type": "integer",
          "minimum": 0,
          "description": "Total number of validation failures across all targets"
        }
      },
      "additionalProperties": false
    },
    "tool": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Validation tool name"
        },
        "version": {
          "type": "string",
          "description": "Validation tool version"
        },
        "imageDigest": {
          "type": "string",
          "pattern": "^ghcr\\.io/.+@sha256:[0-9a-f]{64}$",
          "description": "Digest-pinned container image reference"
        },
        "gitSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "description": "Git commit SHA of validation tool (RFC 0002)"
        },
        "gitShort": {
          "type": "string",
          "pattern": "^[0-9a-f]{7}$",
          "description": "Short git commit SHA (first 7 chars)"
        },
        "platform": {
          "type": "string",
          "description": "Platform architecture (e.g., linux/amd64)"
        }
      },
      "additionalProperties": false
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of validation execution start"
    },
    "matrix": {
      "oneOf": [
        {
          "type": "array",
          "description": "List of validated topology paths (v0.1.0 compatibility)",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "object",
          "description": "Aggregated matrix with per-target details (v0.2.0+)",
          "required": ["enabled", "targets"],
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "True if multi-topology aggregation was used"
            },
            "concurrency": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16,
              "description": "Concurrency level used for parallel validation"
            },
            "executionTimeMs": {
              "type": "integer",
              "minimum": 0,
              "description": "Total wall-clock time for all validations"
            },
            "targets": {
              "type": "array",
              "description": "Per-target validation results",
              "items": {
                "type": "object",
                "required": ["path", "status"],
                "properties": {
                  "path": {
                    "type": "string",
                    "description": "Relative path to topology file"
                  },
                  "status": {
                    "type": "string",
                    "enum": ["ok", "warning", "error"],
                    "description": "Validation status for this target"
                  },
                  "validated": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Number validated for this target"
                  },
                  "warnings": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Number of warnings for this target"
                  },
                  "failures": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Number of failures for this target"
                  },
                  "executionTimeMs": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Validation duration for this target"
                  },
                  "artifactPaths": {
                    "type": "array",
                    "description": "Paths to artifacts generated by this validation (RFC 0002)",
                    "items": {
                      "type": "string"
                    }
                  },
                  "checksum": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$",
                    "description": "SHA256 checksum of topology file (RFC 0002)"
                  },
                  "errors": {
                    "type": "array",
                    "description": "Per-target error messages",
                    "items": {
                      "type": "object",
                      "required": ["message"],
                      "properties": {
                        "message": { "type": "string" },
                        "file": { "type": "string" },
                        "line": { "type": "integer" }
                      }
                    }
                  }
                }
              }
            },
            "details": {
              "type": "array",
              "description": "Detailed per-target metadata for UI mapping (RFC 0002)",
              "items": {
                "type": "object",
                "required": ["target", "status"],
                "properties": {
                  "target": {
                    "type": "string",
                    "description": "Topology file path"
                  },
                  "status": {
                    "type": "string",
                    "enum": ["ok", "warning", "error"]
                  },
                  "artifactPaths": {
                    "type": "array",
                    "items": { "type": "string" }
                  },
                  "executionTimeMs": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "execution": {
      "type": "object",
      "description": "Execution metadata (RFC 0002)",
      "properties": {
        "startTime": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of execution start"
        },
        "endTime": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of execution end"
        },
        "hostname": {
          "type": "string",
          "description": "Hostname of machine running validation"
        },
        "workspace": {
          "type": "string",
          "description": "Absolute path to workspace root"
        }
      },
      "additionalProperties": false
    },
    "errors": {
      "type": "array",
      "description": "Overall error messages if validation failed",
      "items": {
        "type": "object",
        "required": ["message"],
        "properties": {
          "message": { "type": "string" },
          "file": { "type": "string" },
          "line": { "type": "integer" }
        }
      }
    }
  },
  "additionalProperties": false
}
